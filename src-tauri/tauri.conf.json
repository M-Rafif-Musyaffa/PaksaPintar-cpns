{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaksaPintar CPNS",
  "version": "1.5.0",
  "identifier": "com.musya.cpns-PaksaPintar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PaksaPintar CPNS",
        "width": 600,
        "height": 650,
        "center": true,
        "alwaysOnTop": true,
        "visible": false,
        "decorations": false,
        "resizable": false,    
        "maximizable": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.ico"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}